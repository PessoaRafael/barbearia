# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Publishable key (sb_publishable_...). Pode aparecer no navegador: com o RLS
# negando por padrão, ela não lê nada sozinha.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Secret key (sb_secret_...). Só o servidor usa. Nunca no navegador, nunca no git.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Assina o cookie de sessão. Gere com: openssl rand -base64 48
SESSION_SECRET="troque-por-uma-string-longa-e-aleatoria"

# Protege as rotas de cron da Vercel. Gere com: openssl rand -hex 32
CRON_SECRET="troque-por-uma-string-longa-e-aleatoria"

# Qual barbearia este deploy atende.
NEXT_PUBLIC_BARBEARIA_SLUG="johny-barbearia"

# PagBank. Enquanto PAGBANK_ATIVO não for "true", o pix continua manual:
# o Johny confere no extrato e libera no painel.
PAGBANK_ATIVO=false
PAGBANK_AMBIENTE=sandbox
PAGBANK_TOKEN=
# Endereço público do site, para o PagBank avisar quando o pix cair.
SITE_URL=
